# Django Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=True

# MongoDB Configuration
# Local MongoDB: mongodb://localhost:27017/
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/
MONGODB_NAME=tweeter_db

# ImageKit Cloud Storage Configuration
# Get these credentials from your ImageKit.io Dashboard (https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
